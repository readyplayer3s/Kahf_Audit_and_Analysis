<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="user_prefs.xml" />
        <exclude domain="sharedpref" path="AppPreferences.xml" />
        <exclude domain="file" path="device_data/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="AppPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
